# Python tooling output, e.g. from running the dashboard generators locally.
__pycache__/
*.pyc
.ruff_cache/

# RIPER working notes and review reports: session scratch, not config.
.claude/riper-state.md
review.md

# Key material and decrypted secrets must never be committed.
# Encrypted secrets/*.yaml ARE tracked — the pre-commit `sops-encrypted`
# hook is what enforces they stay encrypted.
keys.txt
*.age
*.dec
*.decrypted
secrets/*.plain.yaml
secrets/*.dec.yaml

# Obsidian Vault Protection
# Prevent any vault content from being committed
**/vault/
**/dmjgilbert/
*.obsidian*
*-from-vault.md
vault-*.json
