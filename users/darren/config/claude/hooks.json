{
  "hooks": [
    {
      "event": "SessionStart",
      "matcher": {},
      "action": {
        "type": "command",
        "command": "~/.claude/scripts/session-start.sh default"
      }
    },
    {
      "event": "SessionStart",
      "matcher": {
        "inputContains": "compact"
      },
      "action": {
        "type": "command",
        "command": "~/.claude/scripts/session-start.sh compact"
      }
    },
    {
      "event": "PreCompact",
      "matcher": {},
      "action": {
        "type": "command",
        "command": "echo '{\"systemMessage\": \"About to compact. Save any critical in-progress context or task state now — compaction will replace this conversation history.\"}'"
      }
    },
    {
      "event": "Notification",
      "matcher": {},
      "action": {
        "type": "command",
        "command": "osascript -e 'display notification \"Claude Code needs your attention\" with title \"Claude Code\"' 2>/dev/null || true"
      }
    },
    {
      "event": "PostToolUse",
      "if": "Edit(*.nix)|Write(*.nix)",
      "action": {
        "type": "command",
        "command": "alejandra --quiet \"$(jq -r '.tool_input.file_path // empty')\" 2>/dev/null"
      }
    },
    {
      "event": "PostToolUse",
      "if": "Edit(*.rs)|Write(*.rs)",
      "action": {
        "type": "command",
        "command": "rustfmt \"$(jq -r '.tool_input.file_path // empty')\" 2>/dev/null"
      }
    },
    {
      "event": "PostToolUse",
      "if": "Edit(*.ts)|Write(*.ts)|Edit(*.tsx)|Write(*.tsx)|Edit(*.js)|Write(*.js)|Edit(*.jsx)|Write(*.jsx)|Edit(*.css)|Write(*.css)|Edit(*.html)|Write(*.html)|Edit(*.json)|Write(*.json)",
      "action": {
        "type": "command",
        "command": "prettier --write \"$(jq -r '.tool_input.file_path // empty')\" 2>/dev/null"
      }
    },
    {
      "event": "PostToolUse",
      "if": "Edit(*.dart)|Write(*.dart)",
      "action": {
        "type": "command",
        "command": "dart format \"$(jq -r '.tool_input.file_path // empty')\" 2>/dev/null"
      }
    },
    {
      "event": "PostToolUse",
      "if": "Edit(*.lua)|Write(*.lua)",
      "action": {
        "type": "command",
        "command": "stylua \"$(jq -r '.tool_input.file_path // empty')\" 2>/dev/null"
      }
    },
    {
      "event": "PostToolUse",
      "if": "Edit(*.py)|Write(*.py)",
      "action": {
        "type": "command",
        "command": "ruff format \"$(jq -r '.tool_input.file_path // empty')\" 2>/dev/null"
      }
    },
    {
      "event": "TeammateIdle",
      "matcher": {},
      "action": {
        "type": "command",
        "command": "~/.claude/scripts/quality-gate.sh"
      }
    },
    {
      "event": "Stop",
      "matcher": {},
      "action": {
        "type": "command",
        "command": "~/.claude/scripts/quality-gate.sh"
      }
    }
  ]
}
